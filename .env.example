# Copy to .env.local and fill in from Supabase dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never expose to the browser; add to Vercel too)
SUPABASE_SECRET_KEY=

# --- Notifications (Phase 9) -------------------------------------------------
# All optional. With none set the app runs in DRY-RUN mode: messages are
# composed and written to notification_log with status 'dry_run' but never
# sent, so the pipeline can be tested before DNS and carrier registration land.

# Email — SMTP takes precedence over Resend if both are set.
#
# Google Workspace SMTP: already SPF/DKIM-authorised for launchpadphilly.org,
# so it needs NO DNS changes (the domain's DNS is held by Building 21, not us).
# SMTP_USER must be a real Workspace USER — a Google Group cannot authenticate.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Resend alternative. Needs SPF/DKIM records added in DNS.
RESEND_API_KEY=

# EMAIL_FROM may only differ from SMTP_USER if it's a verified send-as alias or
# the relay allows it — see the setup test in CLAUDE.md.
EMAIL_FROM="Launchpad Philly <apply@launchpadphilly.org>"
# Replies land here (the staff group), not in the sending mailbox.
EMAIL_REPLY_TO=apply@launchpadphilly.org

# SMS — configure ONE provider. Twilio wins if both are present.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# Zoom Phone alternative. Needs a Server-to-Server OAuth app with
# phone_sms:write scopes — see CLAUDE.md for the access caveats.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SMS_FROM=

# Shared secret for the reminder cron endpoint.
CRON_SECRET=
